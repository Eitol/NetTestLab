# NetTestLab Docker Environment Variables
# Copy this file to .env and modify as needed

# OpenWRT Container Configuration
OPENWRT_IMAGE=albrechtloh/openwrt-docker:latest
NETTESTLAB_PORT=8080
NETTESTLAB_DATA_DIR=/tmp/nettestlab
NETTESTLAB_CONFIG_DIR=/etc/nettestlab

# Test Configuration
TEST_TIMEOUT=300
TEST_DEVICES_COUNT=50
TEST_TARGETS_COUNT=20
CONCURRENT_CAPTURES=5

# Network Configuration
DOCKER_SUBNET=192.168.100.0/24
OPENWRT_IP=192.168.100.2
TEST_CLIENT_IP=192.168.100.10
TRAFFIC_GEN_IP=192.168.100.20

# Debugging
DEBUG_MODE=false
VERBOSE_LOGS=false