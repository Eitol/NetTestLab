.vscode/
.idea/
*.swp
*.swo

# Resultados de tests
tests/integration/results/
tests/integration/data/

# Archivos de Go
go.sum
vendor/

# Archivos de OpenWRT específicos (excepto los necesarios)
openwrt/build/
openwrt/*.ipk